# ==============================
# Synthos Backend Configuration
# ==============================

# Core Application Settings
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
ALLOWED_HOSTS=synthos.dev,localhost,127.0.0.1
CORS_ORIGINS=https://synthos.dev,http://localhost:3000

# Database Configuration
USE_CLOUD_SQL_CONNECTOR=true
CLOUDSQL_INSTANCE=your-project:region:instance
DB_USER=synthos
DB_PASSWORD=your-database-password
DB_NAME=synthos
DATABASE_URL=postgresql://synthos:password@localhost:5432/synthos

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379/0
ENABLE_CACHING=true

# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GCS_BUCKET=your-gcs-bucket-name
GCS_SIGNED_URL_TTL=3600

# Vertex AI Configuration
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
VERTEX_DEFAULT_MODEL=claude-opus-4
VERTEX_API_KEY=your-vertex-api-key

# AI Provider API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Payment Processing - Paddle
PADDLE_VENDOR_ID=your-paddle-vendor-id
PADDLE_VENDOR_AUTH_CODE=your-paddle-vendor-auth-code
PADDLE_PUBLIC_KEY=your-paddle-public-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret
PADDLE_ENVIRONMENT=production

# Payment Processing - Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Payment Configuration
PRIMARY_PAYMENT_PROVIDER=paddle
ENABLE_MULTIPLE_PAYMENT_PROVIDERS=true

# AWS Configuration (Optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket
AWS_REGION=us-east-1

# Azure Configuration (Optional)
AZURE_STORAGE_ACCOUNT=your-azure-storage-account
AZURE_STORAGE_KEY=your-azure-storage-key
AZURE_CONTAINER=your-azure-container

# File Storage
UPLOAD_PATH=/app/uploads
EXPORT_PATH=/app/exports

# API Configuration
API_V1_STR=/api/v1
PORT=8080
HOST=0.0.0.0

# Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_STORAGE=redis

# Security Configuration
ENABLE_SENTRY=true
SENTRY_DSN=your-sentry-dsn
FORCE_HTTPS=true
HPKP_PINS=your-hpkp-pins

# Monitoring & Observability
ENABLE_PROMETHEUS=true
ENABLE_GRAFANA=true
GRAFANA_PASSWORD=your-grafana-password

# Privacy & Compliance
ENABLE_DIFFERENTIAL_PRIVACY=true
DEFAULT_EPSILON=1.0
DEFAULT_DELTA=1e-5
PRIVACY_BUDGET_LIMIT=10.0

# Business Logic
FREE_TIER_MONTHLY_LIMIT=10000
MAX_SYNTHETIC_ROWS=5000000
QUALITY_THRESHOLD=0.8

# Pricing Tiers (JSON format)
PRICING_TIERS='{"starter": {"price": 99, "stripe_price_id": "price_starter_monthly", "paddle_product_id": "pro_01jzp36tyrsdg91hprxx47zhwb"}, "professional": {"price": 599, "stripe_price_id": "price_professional_monthly", "paddle_product_id": "pro_01jzp3ds3cj4y0x9y53ftcmmkk"}, "growth": {"price": 1299, "stripe_price_id": "price_growth_monthly", "paddle_product_id": "pro_01jzp3gcsceh34w3jvyyn68rhr"}}'

# Development Settings
MVP_MODE=false
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_SWAGGER_UI=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_STRUCTURED_LOGGING=true

# Performance Settings
MAX_WORKERS=4
WORKER_TIMEOUT=30
KEEP_ALIVE_TIMEOUT=5

# Feature Flags
ENABLE_CUSTOM_MODELS=true
ENABLE_VERTEX_AI=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_WEBHOOKS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_SECURITY_MONITORING=true